{
  "defaultModel": "auto/minimax-m3.1-flash",
  "defaultProvider": "magpie",
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "packages": [
    {
      "source": "npm:pi-show-diffs",
      "extensions": ["+index.ts"]
    },
    {
      "source": "npm:pi-lens",
      "extensions": ["+dist/index.js"]
    },
    {
      "source": "npm:pi-web-access",
      "extensions": ["+dist/index.js"]
    },
    {
      "source": "npm:@juicesharp/rpiv-ask-user-question",
      "extensions": ["+index.ts"]
    },
    {
      "source": "npm:@juicesharp/rpiv-todo",
      "extensions": ["+index.ts"]
    },
    {
      "source": "npm:@juicesharp/rpiv-btw",
      "extensions": ["+index.ts"]
    },
    {
      "source": "npm:@ff-labs/pi-fff",
      "extensions": ["+src/index.ts"]
    },
    {
      "source": "npm:pi-footer",
      "extensions": ["-src/index.ts"]
    },
    {
      "source": "npm:@shennguyenrs/pi-emote",
      "extensions": ["+src/index.ts"]
    },
    "npm:pi-subagents",
    "npm:pi-declutter",
    "npm:pi-cached-compaction",
    "npm:betterwright",
    "npm:@henryqw/pi-codegraph"
  ],
  "hideThinkingBlock": true
}
