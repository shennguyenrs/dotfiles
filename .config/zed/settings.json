// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "soft_wrap": "editor_width",
  "sticky_scroll": {
    "enabled": false
  },
  "terminal": {
    "scrollbar": {
      "show": "never"
    }
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "button": false,
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "remove_trailing_whitespace_on_save": false,
  "edit_predictions": {
    "provider":"zed"
  },
  "agent_servers": {
    "gemini": {
      "default_mode": "plan",
      "type": "registry"
    }
  },
  "prettier": {
    "allowed": false
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "minimax/minimax-m2.7"
    }
  },
  "vim_mode": true,
  "ui_font_family": "SF Pro Display",
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_weight": 300,
  "relative_line_numbers": "enabled",
  "auto_update": false,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Machiato"
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": false
    },
    "show": "auto"
  },
  "tabs": {
    "git_status": true
  },
  "format_on_save": "off"
}
